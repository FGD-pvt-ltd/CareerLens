{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalysisResultSchema",
  "type": "object",
  "properties": {
    "readinessScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "skillScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "evidenceScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "verifiedSkills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidenceSources": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["skill", "confidence"]
      }
    },
    "missingSkills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "roadmap": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "resources": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["step", "title"]
      }
    }
  },
  "required": ["readinessScore", "skillScore", "evidenceScore"]
}
